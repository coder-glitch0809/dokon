INITIAL_ADMIN_LOGIN=LOGIN
INITIAL_ADMIN_PASSWORD=CHANGE_ME_12345
PASSWORD_PEPPER=replace-with-a-random-secret
ALLOWED_ORIGIN=https://dokon-pi.vercel.app
SESSION_IDLE_MINUTES=30
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_IDS=
DAILY_REPORT_TIME=21:00
DB_PATH=data/db.json

# Firebase Realtime Database storage
# FIREBASE_DATABASE_URL example: https://PROJECT_ID-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=https://dokonmalumotlari-default-rtdb.firebaseio.com
FIREBASE_DB_PATH=zamon-market/db

# Server uchun tavsiya qilinadi: Firebase service account
FIREBASE_PROJECT_ID=dokonmalumotlari
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@dokonmalumotlari.iam.gserviceaccount.com
# Service account JSON ichidagi private_key qiymati. Haqiqiy keyni bu faylga yozmang.
# Hosting environment variable uchun qator tashlashlarni literal \n ko'rinishida saqlang.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Bot yoki test uchun sodda variant: Realtime Database secret yoki vaqtinchalik auth token
FIREBASE_DATABASE_SECRET=
FIREBASE_AUTH_TOKEN=

# Faqat Firebase Realtime Database rules public bo'lsa true qiling.
# Production uchun service account tavsiya qilinadi.
FIREBASE_ALLOW_UNAUTHENTICATED=false
